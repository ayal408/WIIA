{
  "manifest_version": 3,
  "name": "Ili Mail — אילי מייל",
  "version": "0.4.0",
  "description": "עיצוב אישי ל־Gmail, תצוגת שיחה כצ׳אט וכלי קול בעברית.",
  "permissions": [
    "storage",
    "tts"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "codes.js",
        "keyboard.js",
        "design.js",
        "extras.js",
        "cards.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}